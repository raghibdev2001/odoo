<odoo>
    <record id="view_quiz_import_wizard" model="ir.ui.view">
        <field name="name">quiz.import.wizard.form</field>
        <field name="model">quiz.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Quizzes">
                <group>
                    <field name="upload_file" filename="file_name"/>
                    <field name="file_name"/>
                </group>
                <footer>
                    <button string="Import" type="object" name="action_import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_quiz_import" model="ir.actions.act_window">
        <field name="name">Import Quizzes</field>
        <field name="res_model">quiz.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

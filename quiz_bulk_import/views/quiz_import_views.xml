<odoo>
  <record id="view_quiz_import_wizard_form" model="ir.ui.view">
    <field name="name">quiz.import.wizard.form</field>
    <field name="model">quiz.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Import Quizzes">
        <group>
          <field name="upload_file" filename="file_name"/>
        </group>
        <footer>
          <button string="Import" type="object" name="action_import_quizzes" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_quiz_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Quizzes</field>
        <field name="res_model">quiz.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

  <menuitem id="menu_quiz_import_root" name="Quiz Import" sequence="100"/>  
  <menuitem id="menu_quiz_import" name="Import Quizzes" parent="menu_quiz_import_root" action="action_quiz_import_wizard" sequence="1"/>
</odoo>